# ============================================
# Configuración Hikvision iVMS-4200
# ============================================

# URL del servidor Hikvision (incluyendo puerto)
# Ejemplo: http://192.168.1.100:8080
HIKVISION_SERVER=http://192.168.1.100:8080

# Credenciales de administrador Hikvision
HIKVISION_USER=admin
HIKVISION_PASS=tu_password_aqui

# Timeout para conexiones (en milisegundos)
HIKVISION_TIMEOUT=10000

# ============================================
# Configuración Supabase
# ============================================

# URL de tu proyecto Supabase
# Obtén desde: https://app.supabase.com/projects
SUPABASE_URL=https://your-project.supabase.co

# Clave anónima de Supabase
# Obtén desde: Project Settings > API > anon key
SUPABASE_KEY=your-anon-key-here

# ============================================
# Configuración de Sincronización
# ============================================

# Intervalo de sincronización (formato cron)
# Ejemplos:
#   '*/5 * * * *'   - Cada 5 minutos
#   '0 * * * *'     - Cada hora
#   '0 0 * * *'     - Una vez al día a medianoche
#   '0 2 * * *'     - Una vez al día a las 2 AM
SYNC_INTERVAL=*/5 * * * *

# Cuántos días atrás sincronizar en cada ejecución
# 1 = solo el día anterior, 7 = última semana
DAYS_TO_SYNC=1

# ============================================
# Configuración Opcional
# ============================================

# Nivel de logging (info, debug, error)
LOG_LEVEL=info

# Enviar notificaciones por email en errores críticos
NOTIFY_EMAIL=admin@empresa.com
