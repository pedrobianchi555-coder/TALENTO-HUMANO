# Supabase Configuration (Local Development)
# Get these from your Supabase project at https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (PostgreSQL via Supabase)
DATABASE_URL=postgresql://postgres:password@localhost:5432/talento_humano

# Mocha Auth Service
MOCHA_USERS_SERVICE_API_URL=https://api.getmocha.com
MOCHA_USERS_SERVICE_API_KEY=your-mocha-api-key

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Gemini (Optional)
GEMINI_API_KEY=your-gemini-api-key

# WhatsApp (Optional)
WHATSAPP_BUSINESS_PHONE_ID=your-whatsapp-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-account-id
WHATSAPP_API_TOKEN=your-whatsapp-token

# App Configuration
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
NODE_ENV=development
